# Shell scripts must be LF on every platform. A .sh checked out with CRLF fails
# on Linux and macOS with "bad interpreter: /usr/bin/env bash^M" — and this repo
# is authored on Windows, so the default would do exactly that.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
